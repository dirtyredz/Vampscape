<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Vampscape</AssemblyName>
    <RootNamespace>Vampscape</RootNamespace>
    <Version>1.0.2</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ModDeployPath>$(MoonlightPeaksPluginDeployPath)\Vampscape</ModDeployPath>
    <!-- The game ships its own copies of every assembly below; never copy them next to the plugin. -->
    <AssemblySearchPaths>$(AssemblySearchPaths);$(MoonlightPeaksManagedPath)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(MoonlightPeaksBepInExCorePath)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MoonlightPeaksBepInExCorePath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Input.GetKey and Input.mouseScrollDelta live here, not in CoreModule. -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(MoonlightPeaksManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Vampire.Runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\Vampire.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CinemachineVirtualCamera and LensSettings - the whole zoom is a lens edit. -->
    <Reference Include="Cinemachine">
      <HintPath>$(MoonlightPeaksManagedPath)\Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MonoBehaviourSingleton, which is how GameCamera and PlayerView are reached. -->
    <Reference Include="littlechickengamecompany.chicken-utilities.runtime">
      <HintPath>$(MoonlightPeaksManagedPath)\littlechickengamecompany.chicken-utilities.runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ReInput, for the controller zoom axis. -->
    <Reference Include="Rewired_Core">
      <HintPath>$(MoonlightPeaksManagedPath)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(ModDeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployPath)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(ModDeployPath)" />
  </Target>

</Project>
